'use client';

import { Card } from '@/components/ui/card';
import { FileText, Smile, Users, TrendingUp, Clock, AlertCircle } from 'lucide-react';
import { useDashboardStats } from '@/app/hooks/use-dashboard-stats';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { Skeleton } from '@/components/ui/skeleton';

export default function Dashboard() {
  const { stats, loading, error } = useDashboardStats(40); // Fetch stats for last 40 days

  if (loading) {
    return (
      <div className="space-y-6">
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {[1, 2, 3, 4].map((i) => (
            <Card key={i} className="p-6">
              <Skeleton className="h-4 w-24 mb-2" />
              <Skeleton className="h-8 w-16 mb-2" />
              <Skeleton className="h-3 w-20" />
            </Card>
          ))}
        </div>
      </div>
    );
  }

  if (error || !stats) {
    return (
      <Alert className="border-red-500">
        <AlertCircle className="h-4 w-4 text-red-500" />
        <AlertDescription>{error || 'Failed to load dashboard'}</AlertDescription>
      </Alert>
    );
  }

  const statCards = [
    {
      label: 'Total Documents',
      value: stats.stats.documents.total.toLocaleString(),
      change: stats.stats.documents.change_percentage 
        ? `${stats.stats.documents.change_percentage > 0 ? '+' : ''}${stats.stats.documents.change_percentage}%`
        : null,
      icon: FileText,
      color: 'text-blue-500'
    },
    {
      label: 'Sentiment Analyses',
      value: stats.stats.sentiment.completed.toString(),
      change: stats.stats.sentiment.processing > 0 
        ? `${stats.stats.sentiment.processing} processing`
        : null,
      icon: Smile,
      color: 'text-green-500'
    },
    {
      label: 'Candidates Screened',
      value: stats.stats.ats.total_candidates.toLocaleString(),
      change: stats.stats.ats.processing > 0
        ? `${stats.stats.ats.processing} jobs running`
        : null,
      icon: Users,
      color: 'text-purple-500'
    },
    {
      label: 'ATS Jobs',
      value: stats.stats.ats.completed.toString(),
      change: `${stats.stats.ats.total_jobs} total`,
      icon: TrendingUp,
      color: 'text-orange-500'
    }
  ];

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-3xl font-bold">Dashboard</h1>
        <p className="text-gray-400 mt-2">
          Overview of your HR analytics (last {stats.period_days} days)
        </p>
      </div>

      {/* Stats Cards */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {statCards.map((stat) => (
          <Card key={stat.label} className="p-6 bg-gray-900 border-gray-800">
            <div className="flex items-center justify-between mb-4">
              <span className="text-sm text-gray-400">{stat.label}</span>
              <stat.icon className={`w-5 h-5 ${stat.color}`} />
            </div>
            <div className="space-y-1">
              <div className="text-3xl font-bold">{stat.value}</div>
              {stat.change && (
                <div className="text-xs text-gray-500">{stat.change}</div>
              )}
            </div>
          </Card>
        ))}
      </div>

      {/* Insights */}
      {stats.insights.length > 0 && (
        <div className="space-y-4">
          <h2 className="text-xl font-semibold">Quick Insights</h2>
          {stats.insights.map((insight: { severity: 'info' | 'warning' | 'error'; message: string }, idx: number) => (
            <Alert 
              key={idx} 
              className={insight.severity === 'warning' ? 'border-red-500' : ''}
            >
              <AlertCircle className={`h-4 w-4 ${insight.severity === 'warning' ? 'text-red-500' : ''}`} />
              <AlertDescription>{insight.message}</AlertDescription>
            </Alert>
          ))}
        </div>
      )}

      {/* Recent Activity */}
      <Card className="p-6 bg-gray-900 border-gray-800">
        <h2 className="text-xl font-semibold mb-4">Recent Activity</h2>
        <div className="space-y-4">
          {stats.recent_activity.length > 0 ? (
            stats.recent_activity.map((activity: { description: string; timestamp: string }, idx: number) => (
              <div key={idx} className="flex items-start gap-3 pb-3 border-b border-gray-800 last:border-0">
                <Clock className="w-4 h-4 text-gray-400 mt-1" />
                <div className="flex-1">
                  <p className="text-sm">{activity.description}</p>
                  <p className="text-xs text-gray-500 mt-1">
                    {new Date(activity.timestamp).toLocaleString()}
                  </p>
                </div>
              </div>
            ))
          ) : (
            <p className="text-sm text-gray-400">No recent activity</p>
          )}
        </div>
      </Card>

      {/* Quick Actions */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        <Card className="p-6 bg-gray-900 border-gray-800 hover:border-blue-500 transition-colors cursor-pointer">
          <FileText className="w-8 h-8 text-blue-500 mb-3" />
          <h3 className="font-semibold mb-2">PA+HR Analysis</h3>
          <p className="text-sm text-gray-400">
            Upload and query HR documents
          </p>
        </Card>

        <Card className="p-6 bg-gray-900 border-gray-800 hover:border-green-500 transition-colors cursor-pointer">
          <Smile className="w-8 h-8 text-green-500 mb-3" />
          <h3 className="font-semibold mb-2">Sentiment Analysis</h3>
          <p className="text-sm text-gray-400">
            Analyze employee feedback
          </p>
        </Card>

        <Card className="p-6 bg-gray-900 border-gray-800 hover:border-purple-500 transition-colors cursor-pointer">
          <Users className="w-8 h-8 text-purple-500 mb-3" />
          <h3 className="font-semibold mb-2">ATS Checker</h3>
          <p className="text-sm text-gray-400">
            Screen candidate resumes
          </p>
        </Card>
      </div>
    </div>
  );
}
